# Required for Docker Compose startup. Use a unique secret outside local demos.
FLOWCRYPID_ADMIN_EMAIL=admin@example.invalid
FLOWCRYPID_ADMIN_PASSWORD=replace-with-a-unique-12-character-password

# Optional single-node tuning.
FLOWCRYPID_WORKER_COUNT=2
FLOWCRYPID_WORKER_MODE=local
FLOWCRYPID_WORKER_POLL_SECONDS=1.0
FLOWCRYPID_RATE_LIMIT_BACKEND=sqlite
FLOWCRYPID_MAX_UPLOAD_BYTES=52428800
FLOWCRYPID_MAX_PACKETS=500000
FLOWCRYPID_RETENTION_DAYS=30
FLOWCRYPID_PRIVACY_MODE=off
FLOWCRYPID_LOG_LEVEL=INFO

# Context controls used by the explainable detector.
FLOWCRYPID_APPROVED_DESTINATIONS=
FLOWCRYPID_SUSPICIOUS_DESTINATIONS=
FLOWCRYPID_CRITICAL_SOURCES=
# JSON map of source IP to expected outbound-byte baseline.
FLOWCRYPID_SOURCE_BASELINES={}
